# Anti-Gravity AI Job Hunting System Configuration

# OpenRouter API Key (Optional for cloud LLM reasoning: get free from openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local Ollama URL (Default local LLM server)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Minimum Match Score for high relevance filtering (0.0 to 1.0)
MIN_SCORE=0.75

# Resume path
RESUME_PATH=resume.md

# Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web Server Port
PORT=5000
